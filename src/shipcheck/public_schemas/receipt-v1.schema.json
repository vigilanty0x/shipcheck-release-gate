{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigilanty0x.github.io/shipcheck-release-gate/schemas/receipt-v1.schema.json",
  "title": "Shipcheck internal-consistency-only receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "assessment_envelope", "assessment_payload_digest", "decision_digest", "bindings", "ledger", "integrity_scope", "authenticity_established", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "shipcheck/receipt-v1"},
    "assessment_envelope": {"type": "object"},
    "assessment_payload_digest": {"$ref": "#/$defs/sha256"}, "decision_digest": {"$ref": "#/$defs/sha256"},
    "bindings": {"type": "object"},
    "ledger": {
      "type": "object", "additionalProperties": false, "required": ["entry", "chain", "anchor"],
      "properties": {
        "entry": {"$ref": "#/$defs/entry"},
        "chain": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/entry"}},
        "anchor": {"type": "object", "additionalProperties": false, "required": ["sequence", "entry_hash"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "entry_hash": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "integrity_scope": {"const": "internal_consistency_only: local SHA-256 hash-chain and local tail anchor; no signature, external checkpoint, transparency log, authorship, or non-repudiation"},
    "authenticity_established": {"const": false}, "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "entry_hash", "previous_hash", "idempotency_key_digest", "request_digest", "entry_type", "payload_digest", "created_at"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1}, "entry_hash": {"$ref": "#/$defs/sha256"},
        "previous_hash": {"$ref": "#/$defs/sha256"}, "idempotency_key_digest": {"$ref": "#/$defs/sha256"},
        "request_digest": {"$ref": "#/$defs/sha256"}, "entry_type": {"type": "string", "minLength": 1, "maxLength": 64},
        "payload_digest": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
